# Copy to .env and fill in. ./start-homelab.sh generates one with random
# secrets if .env is missing.

# --- Storage -----------------------------------------------------------------
# The NTFS drive exposed to Nextcloud as External Storage.
SHARED_DRIVE_PATH=/media/Kelib/DATA/shared_drive
# Where that path appears inside the container.
EXTERNAL_STORAGE_MOUNT_PATH=/mnt/shared_drive
# How it is labelled in the Nextcloud Files sidebar.
# Values containing spaces must stay quoted — start-homelab.sh sources this file.
EXTERNAL_STORAGE_NAME="Shared Drive"
# "all" = available to every user, or a comma-separated list of usernames.
EXTERNAL_STORAGE_USERS=all

# --- Database / cache --------------------------------------------------------
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME

# --- Nextcloud ---------------------------------------------------------------
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=CHANGE_ME
NEXTCLOUD_PORT=8090
# Space-separated. Must include every hostname/IP you browse to, plus
# 'nextcloud-app' so the Homepage widget can query it over the internal network.
NEXTCLOUD_TRUSTED_DOMAINS="localhost 127.0.0.1 10.153.121.93 nextcloud-app"

# --- Dashboards --------------------------------------------------------------
DASHBOARD_PORT=7575
DOZZLE_PORT=8082
UPTIME_KUMA_PORT=3001
# Comma-separated host:port list Homepage will answer to.
HOMEPAGE_ALLOWED_HOSTS=localhost:7575,127.0.0.1:7575,10.153.121.93:7575

# --- Derived (used by dashboard config, set by start-homelab.sh) -------------
LAN_IP=10.153.121.93
